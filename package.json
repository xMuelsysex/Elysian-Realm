{
  "name": "elysian-realm",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build:server && npm run build:ui",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:server && node --test dist/tests/*.test.js",
    "validate:tiled-map": "node scripts/validate-realm-tiled-map.mjs",
    "dev": "node scripts/dev-admin.mjs",
    "admin": "npm run dev",
    "dev:api": "npm run build:server && node dist/src/server/admin/adminServer.js",
    "dev:ui": "vite --host 127.0.0.1 --port 5173",
    "build:packages": "npm run build --workspace @elysian/simulation-agent",
    "build:server": "npm run build:packages && tsc",
    "build:ui": "vite build"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^5.4.5",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@elysian/simulation-agent": "workspace:*",
    "pixi-tiledmap": "^2.8.2",
    "pixi.js": "^8.19.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}

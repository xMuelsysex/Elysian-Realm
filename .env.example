# Optional local LLM provider configuration.
# Copy to .env for local experiments only. Never commit real API keys.

# OpenAI-compatible provider root, e.g. https://api.openai.com/v1,
# https://openrouter.ai/api/v1, or a local compatible gateway.
ELYSIAN_LLM_BASE_URL=https://example-llm-provider.test/v1

# Model name understood by the configured provider.
ELYSIAN_LLM_MODEL=example-model-name

# Secret key for the configured provider. Replace only in your local .env.
ELYSIAN_LLM_API_KEY=changeme

# Optional provider label, API transport, and timeout.
# ELYSIAN_LLM_API_MODE accepts chat_completions (default) or responses.
ELYSIAN_LLM_PROVIDER_NAME=openai-compatible
ELYSIAN_LLM_API_MODE=chat_completions
ELYSIAN_LLM_TIMEOUT_MS=30000
